# IqraQuest website — environment variables.
#
# Copy to `.env.local` for local development. NEVER commit a file with
# real values; `.env*` is gitignored except this example.
#
# Every variable here is PUBLIC by design (NEXT_PUBLIC_ prefix): the
# site is statically exported, so anything it reads is baked into the
# HTML and visible to any visitor. Do not put a secret in this file or
# in the deployment environment expecting it to stay private — the site
# has no server and therefore no place to keep one.

# ---------------------------------------------------------------------
# Store links — the launch switch
# ---------------------------------------------------------------------
# A badge only becomes a working link when BOTH its availability flag is
# "true" AND its URL is set. Setting one without the other keeps the
# badge in "coming soon", which makes it impossible to ship a link to
# nowhere.
#
# On launch day, fill these in and redeploy. Nothing else changes.

NEXT_PUBLIC_APP_AVAILABLE_IOS=false
NEXT_PUBLIC_APPLE_APP_URL=

NEXT_PUBLIC_APP_AVAILABLE_ANDROID=false
NEXT_PUBLIC_GOOGLE_PLAY_URL=

# ---------------------------------------------------------------------
# Contact
# ---------------------------------------------------------------------
# The official support address, shown on /support, /contact and in the
# legal pages. Defaults to support@iqraquest.org.
NEXT_PUBLIC_SUPPORT_EMAIL=support@iqraquest.org

# Optional: a form relay endpoint (Formspree, Basin, a Cloudflare
# Worker...). When set, the contact form POSTs JSON to it and shows a
# real confirmation. When empty, the form composes a pre-filled mailto:
# in the visitor's own mail client and says so on screen.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# ---------------------------------------------------------------------
# Social profiles
# ---------------------------------------------------------------------
# Only platforms with a real URL are rendered in the footer. Leave a
# variable empty and its icon simply does not appear — the site never
# links to a profile that does not exist.
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
